{
  "name": "ui-dev",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "ui": {
        "$path": "src/ui"
      },
      "Rx": {
        "$path": "Packages/Rx.lua"
      },
      "_Index": {
        "$path": "Packages/_Index"
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    }
  }
}
