{
  "name": "ui",
  "globIgnorePaths": [
    "**/*.spec.luau",
    "src/ui/animation",
    "src/ui/testing",
    "src/ui/motion/AccelTween.luau",
    "src/ui/motion/AccelTweenObject.luau"
  ],
  "tree": {
    "$path": "src/ui",
    "Packages": {
      "$className": "Folder",
      "Rx": {
        "$path": "Packages/Rx.lua"
      },
      "_Index": {
        "$path": "Packages/_Index"
      }
    }
  }
}
